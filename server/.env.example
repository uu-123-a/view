MOSS_ENV=development
MOSS_SECRET_KEY=replace-with-at-least-32-random-characters
MOSS_COOKIE_SECURE=false
MOSS_TRUST_PROXY=false
MOSS_LOG_LEVEL=INFO

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

SPARKAI_URL=wss://spark-api.xf-yun.com/v3.1/chat
SPARKAI_APP_ID=
SPARKAI_API_SECRET=
SPARKAI_API_KEY=
SPARKAI_DOMAIN=generalv3

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
DATABASE_ENGINE=mysql
MYSQL_DATABASE=view
MYSQL_ADMIN_DATABASE=view_admin
MYSQL_MIGRATION_DATABASE=view_next
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SYNC_PREFIX=sqlite_
MYSQL_AUTO_INIT=true

# Railway MySQL also exposes MYSQLHOST, MYSQLPORT, MYSQLUSER and MYSQLPASSWORD.
# The application automatically uses those names when the variables above are absent.
